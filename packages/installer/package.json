{
  "name": "@twobrake/monorepo-installer",
  "version": "0.1.0",
  "description": "The installer for an opinionated monorepo starter for TypeScript built on the Bun ecosystem.",
  "keywords": [
    "bun",
    "installer",
    "monorepo",
    "oxfmt",
    "oxlint",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "monorepo-installer": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test-install": "bun run src/index.ts",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@repo/utility": "workspace:*",
    "giget": "^3.3.1"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "type-fest": "^5.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}

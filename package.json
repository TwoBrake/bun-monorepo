{
  "name": "repo",
  "description": "My monorepo setup with Bun.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "app:start": "bun --env-file=.env run --filter '@repo/my-app' start",
    "app:dev": "bun --env-file=.env run --filter '@repo/my-app' dev",
    "db:push": "bun --env-file=.env run --filter @repo/database push",
    "db:generate": "bun --env-file=.env run --filter @repo/database generate",
    "db:migrate": "bun --env-file=.env run --filter @repo/database migrate",
    "prepare": "husky",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "stats": "bunx cloc . --exclude-dir=node_modules,out,types,include,.husky,.vscode,.idea,.forgejo,.github,.codex,.agents,.git --match-f=\"[.]tsx?$\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "cloc": "^2.6.0-cloc",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "bun run lint",
    "src/**/*.{ts,tsx}": "bun run format"
  }
}
